generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Organization {
  id        Int       @id @default(autoincrement()) @map("org_id")
  name      String    @unique @map("org_name") @db.NVarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy Int?      @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy Int?      @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")
  plants    Plant[]

  @@map("organizations")
}

model Plant {
  id        Int          @id @default(autoincrement()) @map("plant_id")
  orgId     Int          @map("org_id")
  plantCode String       @unique @map("plant_code") @db.NVarChar(50)
  plantName String       @map("plant_name") @db.NVarChar(100)
  createdAt DateTime     @default(now()) @map("created_at")
  createdBy Int?         @map("created_by")
  updatedAt DateTime     @updatedAt @map("updated_at")
  updatedBy Int?         @map("updated_by")
  deletedAt DateTime?    @map("deleted_at")
  deletedBy Int?         @map("deleted_by")
  org       Organization @relation(fields: [orgId], references: [id])

  @@map("plants")
}

model User {
  id                Int              @id @default(autoincrement()) @map("user_id")
  userCode          String           @unique @map("user_code") @db.NVarChar(50)
  username          String           @unique @db.NVarChar(100)
  password          String           @db.NVarChar(255)
  status            String           @default("ACTIVE") @db.NVarChar(50)
  authProvider      String           @default("LOCAL") @map("auth_provider") @db.NVarChar(50)
  mfaEnabled        Boolean          @default(false) @map("mfa_enabled")
  passwordChangedAt DateTime?        @map("password_changed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  createdBy         Int?             @map("created_by")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  updatedBy         Int?             @map("updated_by")
  deletedAt         DateTime?        @map("deleted_at")
  deletedBy         Int?             @map("deleted_by")
  userPreferences   UserPreference[]
  userRoles         UserRole[]
  userSessions      UserSession[]

  @@map("users")
}

model Role {
  id           Int              @id @default(autoincrement()) @map("role_id")
  roleCode     String           @unique @map("role_code") @db.NVarChar(50)
  roleName     String           @map("role_name") @db.NVarChar(100)
  description  String?          @db.NVarChar(255)
  status       String           @default("ACTIVE") @db.NVarChar(50)
  isSystemRole Boolean          @default(false) @map("is_system_role")
  createdAt    DateTime         @default(now()) @map("created_at")
  createdBy    Int?             @map("created_by")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  updatedBy    Int?             @map("updated_by")
  deletedAt    DateTime?        @map("deleted_at")
  deletedBy    Int?             @map("deleted_by")
  permissions  RolePermission[]
  roleScopes   RoleScope[]
  userRoles    UserRole[]

  @@map("roles")
}

model RoleScope {
  id         Int      @id @default(autoincrement()) @map("role_scope_id")
  roleId     Int      @map("role_id")
  scopeType  String   @map("scope_type") @db.NVarChar(50)
  scopeValue String   @map("scope_value") @db.NVarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  Int?     @map("created_by")
  role       Role     @relation(fields: [roleId], references: [id])

  @@map("role_scopes")
}

model Permission {
  id             Int              @id @default(autoincrement()) @map("perm_id")
  permissionCode String           @unique @map("permission_code") @db.NVarChar(100)
  permissionName String           @map("permission_name") @db.NVarChar(100)
  moduleName     String           @map("module_name") @db.NVarChar(100)
  description    String?          @db.NVarChar(255)
  createdAt      DateTime         @default(now()) @map("created_at")
  createdBy      Int?             @map("created_by")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  updatedBy      Int?             @map("updated_by")
  deletedAt      DateTime?        @map("deleted_at")
  deletedBy      Int?             @map("deleted_by")
  roles          RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     Int             @id @default(autoincrement()) @map("user_role_id")
  userId Int             @map("user_id")
  roleId Int             @map("role_id")
  scopes UserRoleScope[]
  role   Role            @relation(fields: [roleId], references: [id])
  user   User            @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserRoleScope {
  id         Int      @id @default(autoincrement()) @map("user_role_scope_id")
  userRoleId Int      @map("user_role_id")
  scopeType  String   @map("scope_type") @db.NVarChar(50)
  scopeValue String   @map("scope_value") @db.NVarChar(100)
  userRole   UserRole @relation(fields: [userRoleId], references: [id])

  @@map("user_role_scopes")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("perm_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  sessionId  String   @id @map("session_id") @db.NVarChar(100)
  userId     Int      @map("user_id")
  deviceId   String?  @map("device_id") @db.NVarChar(255)
  ipAddress  String?  @map("ip_address") @db.NVarChar(50)
  loginTime  DateTime @default(now()) @map("login_time")
  lastActive DateTime @default(now()) @map("last_active")
  user       User     @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

model UserPreference {
  id              Int    @id @default(autoincrement()) @map("pref_id")
  userId          Int    @map("user_id")
  preferenceKey   String @map("preference_key") @db.NVarChar(100)
  preferenceValue String @map("preference_value") @db.NVarChar(Max)
  user            User   @relation(fields: [userId], references: [id])

  @@unique([userId, preferenceKey])
  @@map("user_preferences")
}

model Product {
  id        Int         @id @default(autoincrement())
  code      String      @unique @db.NVarChar(50)
  name      String      @db.NVarChar(255)
  category  String      @db.NVarChar(100)
  uom       String      @db.NVarChar(20)
  demands   Demand[]
  inventory Inventory[]
}

model DemandPlanLine {
  id         String   @id @default(uuid())
  partName   String   @map("part_name") @db.NVarChar(100)
  soNumber   String   @map("so_number") @db.NVarChar(100)
  lineNumber String   @map("line_number") @db.NVarChar(50)
  itemCode   String   @map("item_code") @db.NVarChar(50)
  priority   Int      @map("priority")
  planQty    Decimal? @map("plan_qty") @db.Decimal(15, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([partName, soNumber, lineNumber, itemCode])
  @@map("demand_plan_lines")
}

model Demand {
  id         Int      @id @default(autoincrement())
  productId  Int
  quantity   Decimal  @db.Decimal(10, 2)
  targetDate DateTime @db.Date
  status     String   @default("DRAFT") @db.NVarChar(50)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id])
  mps        Mps[]

  @@index([targetDate, status])
}

model Mps {
  id         Int               @id @default(autoincrement())
  demandId   Int
  planDate   DateTime          @db.Date
  plannedQty Decimal           @db.Decimal(10, 2)
  status     String            @default("DRAFT") @db.NVarChar(50)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  demand     Demand            @relation(fields: [demandId], references: [id])
  orders     ProductionOrder[]

  @@index([planDate, status])
}

model MpsSupply {
  id           String   @id @default(uuid())
  partName     String   @map("part_name") @db.NVarChar(100)
  planDate     DateTime @map("plan_date") @db.Date
  supplyWeight Decimal  @map("supply_weight") @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([partName, planDate])
  @@map("mps_supplies")
}

model ProductionOrder {
  id             Int             @id @default(autoincrement())
  mpsId          Int
  batchNo        String          @unique @db.NVarChar(100)
  requiredWeight Decimal         @db.Decimal(10, 2)
  status         String          @default("PENDING") @db.NVarChar(50)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  mps            Mps             @relation(fields: [mpsId], references: [id])
  stockMovements StockMovement[]
  yieldRecords   YieldRecord[]

  @@index([status])
}

model YieldRecord {
  id           Int             @id @default(autoincrement())
  orderId      Int
  inputWeight  Decimal         @db.Decimal(10, 2)
  outputWeight Decimal         @db.Decimal(10, 2)
  yieldPercent Decimal         @db.Decimal(5, 2)
  recordedAt   DateTime        @default(now())
  order        ProductionOrder @relation(fields: [orderId], references: [id])

  @@index([orderId, recordedAt])
}

model Inventory {
  id          Int      @id @default(autoincrement())
  productId   Int
  batchNo     String   @db.NVarChar(100)
  weight      Decimal  @db.Decimal(10, 2)
  location    String   @db.NVarChar(100)
  lastUpdated DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([productId, batchNo, location])
  @@index([batchNo])
}

model StockMovement {
  id        Int              @id @default(autoincrement())
  orderId   Int?
  productId Int
  batchNo   String           @db.NVarChar(100)
  type      String           @db.NVarChar(50)
  weight    Decimal          @db.Decimal(10, 2)
  createdAt DateTime         @default(now())
  order     ProductionOrder? @relation(fields: [orderId], references: [id])

  @@index([productId, batchNo])
  @@index([createdAt])
}

model ChickenYield {
  id           Int       @id @default(autoincrement())
  partCode     String    @unique @map("part_code") @db.NVarChar(50)
  partName     String    @map("part_name") @db.NVarChar(100)
  yieldPercent Decimal   @map("yield_percent") @db.Decimal(5, 2)
  sortOrder    Int       @default(0) @map("sort_order")
  status       String    @default("ACTIVE") @db.NVarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    Int?      @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    Int?      @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    Int?      @map("deleted_by")

  @@map("chicken_yields")
}

model FlowNodeType {
  id        Int                 @id @default(autoincrement())
  typeCode  String              @unique @db.NVarChar(50)
  typeName  String              @db.NVarChar(100)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  fields    FlowNodeTypeField[]
  nodes     FlowNode[]

  @@map("flow_node_types")
}

model FlowNodeTypeField {
  id         Int          @id @default(autoincrement())
  nodeTypeId Int          @map("node_type_id")
  fieldName  String       @map("field_name") @db.NVarChar(100)
  dataType   String       @map("data_type") @db.NVarChar(50)
  isRequired Boolean      @default(false) @map("is_required")
  sortOrder  Int          @default(0) @map("sort_order")
  nodeType   FlowNodeType @relation(fields: [nodeTypeId], references: [id], onDelete: Cascade)

  @@map("flow_node_type_fields")
}

model FlowBoard {
  id        Int        @id @default(autoincrement())
  name      String     @db.NVarChar(100)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  isLocked  Boolean    @default(false) @map("is_locked")
  edges     FlowEdge[]
  nodes     FlowNode[]

  @@map("flow_boards")
}

model ProductSpec {
  id           Int      @id @default(autoincrement())
  erpItemCode  String   @unique @map("erp_item_code")
  productType  String?  @map("product_type")
  yieldPercent Float?   @map("yield_percent")
  manSpeed     Float?   @map("man_speed")
  iCutSpeed    Float?   @map("i_cut_speed")
  isExternalRm Boolean  @default(false) @map("is_external_rm")
  rmSizesJson  String?  @map("rm_sizes_json") @db.NVarChar(Max)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  itemCategory String?  @map("item_category")
  leadMaxDays  Int?     @map("lead_max_days")
  leadMinDays  Int?     @map("lead_min_days")

  @@map("product_specs")
}

model FlowNode {
  id         String       @id @db.NVarChar(100)
  boardId    Int          @map("board_id")
  nodeTypeId Int          @map("node_type_id")
  name       String       @db.NVarChar(100)
  positionX  Float        @map("position_x")
  positionY  Float        @map("position_y")
  data       String       @db.NVarChar(Max)
  board      FlowBoard    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  nodeType   FlowNodeType @relation(fields: [nodeTypeId], references: [id])

  @@index([boardId])
  @@map("flow_nodes")
}

model FlowEdge {
  id           String    @id @db.NVarChar(100)
  boardId      Int       @map("board_id")
  source       String    @db.NVarChar(100)
  target       String    @db.NVarChar(100)
  sourceHandle String?   @map("source_handle") @db.NVarChar(100)
  targetHandle String?   @map("target_handle") @db.NVarChar(100)
  board        FlowBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@map("flow_edges")
}

model ChickenWeight {
  id            Int                      @id @default(autoincrement())
  minWeight     Decimal                  @map("min_weight") @db.Decimal(10, 4)
  maxWeight     Decimal                  @map("max_weight") @db.Decimal(10, 4)
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  distributions PartWeightDistribution[]

  @@map("chicken_weights")
}

model PartRmSize {
  id            Int                      @id @default(autoincrement())
  partName      String                   @map("part_name") @db.NVarChar(100)
  minSize       Decimal?                 @map("min_size") @db.Decimal(10, 4)
  maxSize       Decimal?                 @map("max_size") @db.Decimal(10, 4)
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  distributions PartWeightDistribution[]

  @@index([partName])
  @@map("part_rm_sizes")
}

model PartWeightDistribution {
  id              Int           @id @default(autoincrement())
  partName        String        @map("part_name") @db.NVarChar(100)
  chickenWeightId Int           @map("chicken_weight_id")
  partRmSizeId    Int           @map("part_rm_size_id")
  percent         Decimal       @db.Decimal(5, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  chickenWeight   ChickenWeight @relation(fields: [chickenWeightId], references: [id], onDelete: Cascade)
  partRmSize      PartRmSize    @relation(fields: [partRmSizeId], references: [id])

  @@unique([partName, chickenWeightId, partRmSizeId])
  @@map("part_weight_distributions")
}

model ErpItemMaster {
  id              String    @id @default(uuid())
  erpItemId       String    @unique @map("erp_item_id")
  erpItemCode     String    @unique @map("erp_item_code")
  erpItemDesc     String    @map("erp_item_desc") @db.NVarChar(255)
  erpItemType     String    @map("erp_item_type") @db.NVarChar(50)
  erpItemUom      String    @map("erp_item_uom") @db.NVarChar(20)
  erpSecondaryUom String?   @map("erp_secondary_uom") @db.NVarChar(20)
  erpIsActive     Boolean   @default(true) @map("erp_is_active")
  erpUpdatedAt    DateTime? @map("erp_updated_at")
  lastSyncedAt    DateTime  @default(now()) @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("erp_item_master")
}

model ErpSaleOrderHeader {
  id                String             @id @default(uuid())
  erpOrderHeaderId  String             @unique @map("erp_order_header_id")
  erpOrgId          String             @map("erp_org_id")
  erpOrderDate      DateTime           @map("erp_order_date")
  erpOrderNumber    String             @unique @map("erp_order_number")
  erpOrderType      String             @map("erp_order_type") @db.NVarChar(100)
  erpCustomerNumber String             @map("erp_customer_number") @db.NVarChar(50)
  erpCustomerName   String             @map("erp_customer_name") @db.NVarChar(255)
  erpCustomerGrade  String?            @map("erp_customer_grade") @db.NVarChar(50)
  erpCreationDate   DateTime           @map("erp_creation_date")
  erpLastUpdateDate DateTime           @map("erp_last_update_date")
  erpOrderStatus    String             @map("erp_order_status") @db.NVarChar(50)
  lastSyncedAt      DateTime           @default(now()) @map("last_synced_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  ErpSaleOrderLine  ErpSaleOrderLine[]

  @@index([erpOrderDate])
  @@map("erp_sale_order_headers")
}

model ErpSaleOrderLine {
  id                String             @id @default(uuid())
  erpOrderLineId    String             @unique @map("erp_order_line_id")
  headerId          String             @map("header_id")
  erpItemId         String             @map("erp_item_id")
  erpItemCode       String             @map("erp_item_code") @db.NVarChar(50)
  orderedQuantity   Decimal            @map("ordered_quantity") @db.Decimal(15, 4)
  orderQuantityUom  String             @map("order_quantity_uom") @db.NVarChar(20)
  unitSellingPrice  Decimal            @map("unit_selling_price") @db.Decimal(15, 4)
  scheduleShipDate  DateTime?          @map("schedule_ship_date")
  erpCreationDate   DateTime           @map("erp_creation_date")
  erpLastUpdateDate DateTime           @map("erp_last_update_date")
  lastSyncedAt      DateTime           @default(now()) @map("last_synced_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  erpLineNumber     String?            @map("erp_line_number") @db.NVarChar(20)
  header            ErpSaleOrderHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)

  @@index([headerId])
  @@index([erpItemId])
  @@index([scheduleShipDate])
  @@map("erp_sale_order_lines")
}

model SystemSetting {
  key         String   @id @db.NVarChar(100)
  value       String   @db.NVarChar(Max)
  description String?  @db.NVarChar(255)
  category    String   @default("GENERAL") @db.NVarChar(50)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   Int?     @map("updated_by")

  @@map("system_settings")
}

model MonthlyChickenReceiving {
  id               String   @id @default(uuid())
  receiveDate      DateTime @map("receive_date") @db.Date
  numberOfChickens Int      @map("number_of_chickens")
  totalWeight      Decimal  @map("total_weight") @db.Decimal(15, 2)
  averageWeight    Decimal  @map("average_weight") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("monthly_chicken_receiving")
}

model WeeklyChickenReceiving {
  id               String   @id @default(uuid())
  receiveDate      DateTime @map("receive_date") @db.Date
  shift            String   @db.NVarChar(50)
  totalCount       Int      @map("total_count")
  totalWeight      Decimal  @map("total_weight") @db.Decimal(15, 2)
  averageWeight    Decimal  @map("average_weight") @db.Decimal(10, 2)
  farmName         String?  @map("farm_name") @db.NVarChar(255)
  standardFarmName String?  @map("standard_farm_name") @db.NVarChar(255)
  house            String?  @db.NVarChar(100)
  sex              String?  @db.NVarChar(50)
  healthStatus     String?  @map("health_status") @db.NVarChar(100)
  batch            String?  @db.NVarChar(100)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("weekly_chicken_receiving")
}
